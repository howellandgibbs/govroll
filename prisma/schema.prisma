datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

model Profile {
  id          String   @id // Supabase auth user UUID
  username    String   @default("Anonymous")
  email       String?
  preferences Json     @default("{}")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  comments      Comment[]
  commentVotes  CommentVote[]
  votes         Vote[]
  voteHistory   VoteHistory[]
  conversations Conversation[]
  donations     Donation[]

  @@index([username])
}

model Bill {
  id                    Int                      @id @default(autoincrement())
  billId                String                   @unique
  title                 String
  date                  DateTime
  billType              String
  currentChamber        String?
  currentStatus         String
  currentStatusDate     DateTime
  introducedDate        DateTime
  link                  String
  shortText             String?
  fullText              String?
  sponsor               String?
  // bioguideId of the sponsor — populated alongside `sponsor` text when the
  // Congress.gov bill detail endpoint returns one. Lets the rep card surface
  // "Sponsored this bill" when the user's senator/representative is the
  // sponsor instead of falsely reading as "no engagement."
  sponsorBioguideId     String?
  cosponsorCount        Int?
  cosponsorPartySplit   String?
  policyArea            String?
  latestActionText      String?
  latestActionDate      DateTime?
  // Momentum signal — computed daily by compute-momentum.
  // Tier: DEAD | DORMANT | STALLED | ACTIVE | ADVANCING | ENACTED
  // deathReason: CONGRESS_ENDED | FAILED_VOTE | VETOED | LONG_SILENCE | null
  congressNumber        Int?
  momentumScore         Int?
  momentumTier          String?
  daysSinceLastAction   Int?
  deathReason           String?
  momentumComputedAt    DateTime?
  // Most recent action that materially advanced the bill (markup, vote,
  // chamber passage, etc. — see isMajorAction in momentum.ts). Drives
  // the recency component of the score so procedural noise (sub-referrals,
  // technical corrections) doesn't pump the ranking.
  latestMajorActionDate DateTime?
  // Set when an action in the last ~14 days matches an imminent-floor-vote
  // pattern (placed on calendar, cloture motion, rule reported, etc.).
  // Drives a small score boost and floors the tier at ACTIVE so advocates
  // can find vote-imminent bills.
  hasImminentFloorAction Boolean                  @default(false)
  // Set whenever refresh-bill-metadata successfully calls Congress.gov.
  // Used to avoid re-fetching bills whose CRS summary hasn't been
  // published yet — without it the cron loops over ~12k bills forever.
  lastMetadataRefreshAt DateTime?
  // Set whenever fetch-bill-text runs against a bill (success OR failure).
  // The text backfill cron orders by this ascending NULLS FIRST so bills we
  // can't get text for (genuinely unpublished, withdrawn, etc.) rotate to
  // the back of the queue instead of blocking all other bills behind them.
  textFetchAttemptedAt  DateTime?
  // Set whenever backfill-bill-actions runs against a bill (success OR
  // failure) and refreshes its action history + reconciles currentStatus.
  // Distinct from lastMetadataRefreshAt — that one tracks the
  // CRS-summary/titles cooldown; this one drives the rolling status
  // refresh that fixes the Farm Bill staleness class. Cron orders by
  // this ascending NULLS FIRST so bills we've never refreshed are
  // first, then oldest-refresh, with newly-active bills resurfacing
  // when their `currentStatusDate` advances elsewhere in the pipeline.
  lastActionRefreshAt   DateTime?
  // Title variants fetched from Congress.gov /titles endpoint. We search
  // on all of these via the weighted searchVector generated column —
  // users type popular names ("CHIPS Act"), not official titles. Each
  // title column also has a GIN trigram index for fuzzy matching; those
  // live in migrations because @@index can't express gin_trgm_ops.
  popularTitle          String?
  shortTitle            String?
  displayTitle          String?
  searchVector          Unsupported("tsvector")?
  // AI-generated plain-language explainer shown at the top of the bill
  // detail page. `aiSummaryVersionId` points at the BillTextVersion.id the
  // explainer was generated from, so the backfill script can regenerate
  // after a new substantive amendment lands. Kept as a loose Int (not a
  // relation) for consistency with other AI-provenance columns.
  aiShortDescription    String?
  aiKeyPoints           String[]                 @default([])
  aiSummaryModel        String?
  aiSummaryCreatedAt    DateTime?
  aiSummaryVersionId    Int?
  // Set after `embedBill` finishes writing every chunk for the latest
  // text version. Null = no embeddings; an Int = which BillTextVersion
  // is fully embedded right now. The candidate filter in the embedding
  // pipeline checks this field rather than "any chunk exists" so a
  // mid-run failure on a giant bill (multi-tx persistChunks doesn't
  // wrap delete+inserts atomically) doesn't get silently marked done.
  embeddingsTextVersionId Int?
  embeddingsCompletedAt   DateTime?
  votes                 RepresentativeVote[]
  publicVotes           Vote[]
  comments              Comment[]
  conversations         Conversation[]
  actions               BillAction[]
  textVersions          BillTextVersion[]
  voteHistory           VoteHistory[]
  cosponsors            BillCosponsor[]
  aiSummaryFeedback     AiSummaryFeedback[]
  embeddingChunks       BillEmbeddingChunk[]
  // Partial index on textFetchAttemptedAt (WHERE fullText IS NULL) lives in
  // the 20260418150000 migration — Prisma schema can't express partial
  // indexes, and a full-table index would waste space on the bills that
  // already have text.
  //
  // Composite index (momentumComputedAt ASC NULLS FIRST, latestActionDate DESC
  // NULLS LAST) backing compute-momentum's batch selection lives in the
  // 20260609170000 migration — Prisma's @@index can't express the NULLS
  // ordering the cron's ORDER BY relies on.

  @@index([momentumTier, momentumScore(sort: Desc)])
  @@index([congressNumber])
}

model BillCosponsor {
  id               Int       @id @default(autoincrement())
  billId           Int
  representativeId Int
  sponsoredAt      DateTime?
  isOriginal       Boolean   @default(false)
  withdrawnAt      DateTime?

  bill           Bill           @relation(fields: [billId], references: [id], onDelete: Cascade)
  representative Representative @relation(fields: [representativeId], references: [id])

  @@unique([billId, representativeId])
  @@index([billId])
  @@index([representativeId])
}

model BillAction {
  id         Int      @id @default(autoincrement())
  billId     Int
  actionDate DateTime
  chamber    String?
  text       String
  actionType String?

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@unique([billId, actionDate, text])
  @@index([billId])
}

model Representative {
  id             Int                  @id @default(autoincrement())
  bioguideId     String               @unique
  slug           String?              @unique
  firstName      String
  lastName       String
  state          String
  district       String?
  party          String
  chamber        String
  imageUrl       String?
  link           String?
  phone          String?
  // End of the member's current term (Jan 3 of an odd year), from GovTrack's
  // role.enddate. Drives the next-election countdown: the deciding election is
  // the prior November, so next election = year(termEnd) - 1. This is what
  // distinguishes a state's two senators, who sit in different election classes.
  termEnd        DateTime?
  votes          RepresentativeVote[]
  cosponsorships BillCosponsor[]
}

model RepresentativeVote {
  id               Int       @id @default(autoincrement())
  representativeId Int
  billId           Int
  vote             String
  rollCallNumber   Int?
  chamber          String?
  votedAt          DateTime?
  category         String?

  representative Representative @relation(fields: [representativeId], references: [id])
  bill           Bill           @relation(fields: [billId], references: [id])

  @@unique([representativeId, billId, rollCallNumber])
  @@index([billId, chamber])
  @@index([billId, rollCallNumber])
  // Serves the vote-recency signal (vote-recency.ts): newest vote per
  // chamber, queried every 10 min. chamber is stored lowercase.
  @@index([chamber, votedAt(sort: Desc)])
}

model BillTextVersion {
  id                Int       @id @default(autoincrement())
  billId            Int
  versionCode       String
  versionType       String
  versionDate       DateTime
  fullText          String?
  // Character length of `fullText`, written at ingest alongside it. Lets
  // size-threshold scans (e.g. the embed-large-bills candidate filter)
  // avoid detoasting every bill's fullText just to call LENGTH() on it.
  // Null only for rows whose fullText is null (or not yet backfilled).
  textLength        Int?
  isSubstantive     Boolean   @default(true)
  changeSummary     String?
  // AI-generated one-sentence captions for each parsed section, used by
  // the bill reader's smart outline. Stored as [{ sectionId, caption }]
  // aligned to the slugs produced by sectionSlugsForBill(...). Null means
  // "not yet generated for this version" — the reader degrades gracefully.
  sectionCaptions   Json?
  captionsModel     String?
  captionsCreatedAt DateTime?
  createdAt         DateTime  @default(now())

  bill            Bill                 @relation(fields: [billId], references: [id])
  activeVotes     Vote[]
  voteHistory     VoteHistory[]
  summaryJob      SummaryJob?
  embeddingChunks BillEmbeddingChunk[]

  @@unique([billId, versionCode])
  @@index([billId])
  @@index([versionDate])
}

/// Vector retrieval chunks for the RAG path on bills too large to fit
/// in the chat context window. One row per parsed section per text
/// version. The `embedding` column is pgvector(1024) — declared as
/// Unsupported() because Prisma has no native vector type; raw SQL
/// writes/queries handle the actual embedding payload.
///
/// `contextPrefix` is the one-line context summary generated by Haiku
/// (Anthropic's contextual-retrieval pattern) prepended to the chunk
/// text before embedding, so retrieval can disambiguate sections that
/// look similar in isolation.
model BillEmbeddingChunk {
  id             Int                         @id @default(autoincrement())
  billId         Int
  textVersionId  Int
  chunkIndex     Int
  sectionRef     String
  heading        String
  content        String
  contextPrefix  String
  embedding      Unsupported("vector(1024)")
  embeddingModel String
  createdAt      DateTime                    @default(now())

  bill        Bill            @relation(fields: [billId], references: [id], onDelete: Cascade)
  textVersion BillTextVersion @relation(fields: [textVersionId], references: [id], onDelete: Cascade)

  @@unique([billId, textVersionId, chunkIndex])
  @@index([billId])
  @@index([textVersionId])
}

// ============================================================================
// Ingest plumbing — resumable cursors and lazy AI-generation job tracking
// ============================================================================

// Persisted resume point for long-running ingest tasks. Each task owns one row
// (keyed by task name) and advances the cursor as it makes progress. Lets a
// 60s-capped cron do small slices without losing track of where it left off.
model IngestCursor {
  key       String   @id
  cursor    DateTime
  updatedAt DateTime @updatedAt
}

// One row per BillTextVersion that is currently (or has recently been) having
// its AI change-summary generated. Acts as a lightweight queue / dedupe so
// multiple viewers of the same bill don't double-spend on generation, and so
// the UI can show a distinct "generating" state instead of a bare null.
model SummaryJob {
  versionId    Int       @id
  status       String
  startedAt    DateTime  @default(now())
  completedAt  DateTime?
  errorMessage String?

  textVersion BillTextVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([status])
  // Supports assertOndemandSummaryDailyCap()'s `count(startedAt >= todayStart)`
  // on the public summary endpoint's trigger path, so the daily-cap check stays
  // an index range scan instead of a growing seq scan.
  @@index([startedAt])
}

model Vote {
  id            Int      @id @default(autoincrement())
  userId        String
  billId        Int
  voteType      String
  textVersionId Int?
  votedAt       DateTime @default(now())

  profile     Profile          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bill        Bill             @relation(fields: [billId], references: [id], onDelete: Cascade)
  textVersion BillTextVersion? @relation(fields: [textVersionId], references: [id])

  @@unique([userId, billId])
  @@index([userId])
  // Covering index for the Vote.billId FK (flagged by the Supabase advisor).
  @@index([billId])
}

model VoteHistory {
  id            Int      @id @default(autoincrement())
  userId        String
  billId        Int
  voteType      String
  textVersionId Int?
  createdAt     DateTime @default(now())

  profile     Profile          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bill        Bill             @relation(fields: [billId], references: [id], onDelete: Cascade)
  textVersion BillTextVersion? @relation(fields: [textVersionId], references: [id])

  @@index([userId, billId])
  @@index([billId])
}

model Comment {
  id              Int      @id @default(autoincrement())
  content         String
  userId          String?
  username        String   @default("Anonymous")
  billId          Int
  parentCommentId Int?
  date            DateTime @default(now())

  profile       Profile?      @relation(fields: [userId], references: [id], onDelete: SetNull)
  bill          Bill          @relation(fields: [billId], references: [id], onDelete: Cascade)
  parentComment Comment?      @relation("CommentToReplies", fields: [parentCommentId], references: [id], onDelete: SetNull)
  replies       Comment[]     @relation("CommentToReplies")
  commentVotes  CommentVote[]

  @@index([userId])
  @@index([billId])
  @@index([billId, parentCommentId])
  // Covers the parentCommentId FK on its own (the composite above leads
  // with billId, so it can't serve parent-only lookups or cascade deletes).
  @@index([parentCommentId])
}

model CommentVote {
  id        Int    @id @default(autoincrement())
  userId    String
  commentId Int
  voteType  Int

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  comment Comment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@index([commentId])
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String
  billId    Int
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)
  bill    Bill    @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([userId, billId])
  @@index([billId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         String
  text           String
  createdAt      DateTime     @default(now())

  // Demand-signal columns for the rep-mention chat feature. Populated on
  // user-sender rows when the client's intent detector matched a rep in
  // the user's reps-for-bill list. Null on assistant rows. Lets us answer
  // "how often do users actually ask 'why did X vote' on this platform?"
  // before deciding whether to invest in web-search-grounded rationale.
  mentionedRepBioguideId String?
  // True when the user's wording also tripped the why/explain/rationale
  // intent — separates "tell me about Sanders" from "why did Sanders vote no".
  wasWhyIntent           Boolean  @default(false)

  @@index([conversationId])
  // Demand-signal queries scan recent messages by intent or by rep, so we
  // index each independently. createdAt is the second key so the planner
  // can drive a time-windowed aggregate without a sort.
  @@index([wasWhyIntent, createdAt])
  @@index([mentionedRepBioguideId, createdAt])
}

// ============================================================================
// Donations, budget, and AI cost guardrails
// ============================================================================

enum DonationDisplayMode {
  ANONYMOUS
  NAMED
  TRIBUTE
}

enum DonationModStatus {
  PENDING
  APPROVED
  FLAGGED
  REJECTED
}

enum RecurringStatus {
  ACTIVE
  GRACE
  LAPSED
  CANCELED
}

model Donation {
  id               String              @id @default(cuid())
  // Stripe identifiers. For one-time: PaymentIntent id. For recurring: Subscription id.
  stripePaymentId  String              @unique
  stripeCustomerId String?
  // Supabase auth user id — nullable because logged-out donations are allowed.
  userId           String?
  amountCents      Int
  currency         String              @default("usd")
  isRecurring      Boolean             @default(false)
  recurringStatus  RecurringStatus?
  displayMode      DonationDisplayMode @default(ANONYMOUS)
  displayName      String? // post-moderation, safe to show publicly
  displayNameRaw   String? // pre-moderation, audit trail only
  tributeName      String? // post-moderation
  tributeNameRaw   String? // pre-moderation
  moderationStatus DonationModStatus   @default(PENDING)
  moderationNotes  String?
  regionCode       String? // state-level only (e.g. "US-OH") from Stripe billing
  email            String? // for receipt + linking token
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  hiddenAt         DateTime? // user-requested removal from public page (soft)

  profile   Profile?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  linkToken DonorLinkToken?

  @@index([createdAt])
  @@index([userId])
  @@index([isRecurring, recurringStatus])
  @@index([moderationStatus])
}

model DonorLinkToken {
  id         String    @id @default(cuid())
  donationId String    @unique
  token      String    @unique
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  donation Donation @relation(fields: [donationId], references: [id], onDelete: Cascade)

  @@index([token])
}

// Idempotency ledger for Stripe webhook delivery. Stripe guarantees
// at-least-once delivery and retries any event we don't ack with a 2xx
// (including on timeout), so the same `event.id` can arrive multiple times.
// The webhook claims the id here — in the same transaction that records the
// event's income — so a duplicate delivery hits the primary key and is acked
// without double-counting, while a mid-handler failure rolls the claim back
// and lets Stripe's retry re-apply it cleanly.
//
// This is the only dedupe key the recurring-renewal path has: a renewal
// (invoice.payment_succeeded) creates no Donation row, so without this row
// every redelivery of a renewal invoice would increment incomeCents again.
// The one-time/first-charge path dedupes on Donation.stripePaymentId instead.
//
// Rows are write-once and safe to prune after Stripe's retry window (~3 days);
// kept indefinitely for now given the low event volume.
model ProcessedStripeEvent {
  id          String   @id // Stripe event id, e.g. "evt_..."
  type        String // event type, retained for auditing/debugging
  processedAt DateTime @default(now())
}

model BudgetLedger {
  id               String   @id @default(cuid())
  // YYYY-MM identifier for the budget period. One row per month.
  period           String   @unique
  incomeCents      Int      @default(0)
  // Surplus rolled forward from the previous period's row at the time
  // this row was first created. Lets unspent donations keep funding the
  // project across the month boundary instead of resetting to $0.
  // Treated like income for the purposes of `availableCents` and the
  // public progress bar.
  carryoverCents   Int      @default(0)
  spendCents       Int      @default(0)
  // Reserve withheld from "available" before flipping AI on.
  reserveCents     Int      @default(0)
  aiEnabled        Boolean  @default(true)
  // Reason the current aiEnabled value was set. "budget" | "manual" | "bootstrap"
  aiDisabledReason String?
  lastEvaluated    DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model AiUsageEvent {
  id           String   @id @default(cuid())
  userId       String?
  // Logical feature name, e.g. "chat" | "bill_summary" | "section_explain" | "moderation"
  feature      String
  model        String
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  costCents    Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([feature, createdAt])
}

// Anonymous thumbs-up/-down on AI-generated bill content. Snapshots the
// model + bill text version that produced the rated output so quality can
// be analyzed per model/version even after a later regeneration overwrites
// the columns on Bill.
model AiSummaryFeedback {
  id                 String   @id @default(cuid())
  billId             Int
  // Which AI surface was rated. v1: "explainer". Future: "change_summary".
  surface            String
  aiSummaryVersionId Int?
  aiSummaryModel     String?
  // 1 = thumbs up, -1 = thumbs down. Matches CommentVote convention.
  rating             Int
  createdAt          DateTime @default(now())

  bill Bill @relation(fields: [billId], references: [id], onDelete: Cascade)

  @@index([billId, surface, createdAt])
  @@index([createdAt])
}

model AiResponseCache {
  id         String   @id @default(cuid())
  billId     Int
  promptHash String
  response   String
  model      String
  createdAt  DateTime @default(now())
  expiresAt  DateTime

  @@unique([billId, promptHash])
  @@index([expiresAt])
}

model AdminUser {
  id        String   @id @default(cuid())
  // Supabase auth user id (uuid)
  userId    String   @unique
  email     String?
  notes     String?
  createdAt DateTime @default(now())

  @@index([userId])
}

// ============================================================================
// Congress session status — "is Congress working right now?" indicator
// ============================================================================

// Live per-chamber status, recomputed every ~10 minutes by the
// compute-congress-status cron. One row per chamber, upserted.
//
// status values:
//   voting              — chamber is on the floor and voted recently
//   in_session          — chamber gaveled in with floor activity
//   pro_forma           — brief procedural session with no legislative business
//   adjourned_today     — gaveled in earlier today, then gaveled out for the day
//   recess              — scheduled non-session period
//   adjourned_sine_die  — formal end of session (between Congresses)
//   unknown             — no signal resolved; render a neutral pill
//
// source is whichever signal in the waterfall produced this status:
//   clerk_xml | senate_pail | vote_recency | calendar | none
model CongressChamberStatus {
  chamber             String    @id // "house" | "senate"
  status              String
  detail              String? // short human label — e.g. "Roll call vote 18 min ago"
  source              String
  lastActionAt        DateTime? // timestamp from the source signal itself
  nextTransitionAt    DateTime? // next scheduled transition start (recess begin / session resume)
  nextTransitionLabel String? // "Memorial Day District Work Period", "Returns Apr 28", etc.
  scheduledConveneAt  DateTime? // wall-clock convene time on a pre_session day (parsed from PAIL "Convene at …")
  lastCheckedAt       DateTime  @default(now()) // when the cron last ran the waterfall
  updatedAt           DateTime  @updatedAt
}

// Published non-session periods, seeded per-year from the official
// House Majority Leader and Senate calendars. Used as the fallback
// tier in the waterfall when no live signal is present today.
model CongressRecess {
  id        String   @id @default(cuid())
  chamber   String // "house" | "senate"
  startDate DateTime @db.Date
  endDate   DateTime @db.Date // inclusive
  label     String

  @@index([chamber, startDate, endDate])
}
